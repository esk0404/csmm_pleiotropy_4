library(data.table)
library(here)

data_dir <- here("results")
output_dir <- here("tables")

fe_meta <- fread(file.path(data_dir, "fe_meta_sig.csv"))
re_meta <- fread(file.path(data_dir, "re_meta_sig.csv"))
asset1 <- fread(file.path(data_dir, "asset1_sig.csv"))
asset2 <- fread(file.path(data_dir, "asset2_sig.csv"))
csmgmm_t2 <- fread(file.path(data_dir, "csmgmm_sig.csv"))

overlap_table <- data.table(
  Comparison = c(
    "csmGmm vs Fixed Effects",
    "csmGmm vs Random Effects",
    "csmGmm vs ASSET (1-sided)",
    "csmGmm vs ASSET (2-sided)"
  ),
  Overlap_SNPs = c(
    length(intersect(csmgmm_t2$rsid, fe_meta$rsid)),
    length(intersect(csmgmm_t2$rsid, re_meta$rsid)),
    length(intersect(csmgmm_t2$rsid, asset1$rsid)),
    length(intersect(csmgmm_t2$rsid, asset2$rsid))
  )
)

fwrite(
  overlap_table,
  file.path(output_dir, "method_overlap.csv")
)

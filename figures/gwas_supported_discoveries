library(dplyr)
library(data.table)
library(tidyr)
library(ggplot2)
library(here)

data_dir <- here("results")
output_dir <- here("figures")

fe_meta <- fread(file.path(data_dir, "Pleiotropy_K4_fe_all_zp.csv"))
re_meta <- fread(file.path(data_dir, "Pleiotropy_K4_re_all_zp.csv"))
asset1 <- fread(file.path(data_dir, "asset1_sig_zp.csv"))
asset2 <- fread(file.path(data_dir, "asset2_sig_zp.csv"))
csmgmm_t2 <- fread(file.path(data_dir, "csmgmm_sig.csv"))

add_gwas_support <- function(dat, threshold = 1.28e-8) {
  
  dat %>%
    mutate(
      Breast_supported = P_Breast < threshold,
      Lung_supported = P_Lung < threshold,
      Ovarian_supported = P_Ovarian < threshold,
      Prostate_supported = P_Prostate < threshold,
      
      N_cancers_GWAS_supported = rowSums(
        cbind(
          Breast_supported,
          Lung_supported,
          Ovarian_supported,
          Prostate_supported
        ),
        na.rm = TRUE
      ),
      
      GWAS_support = ifelse(
        N_cancers_GWAS_supported >= 2,
        "GWAS-supported",
        "Not GWAS-supported"
      )
    )
}

fe_validation <- add_gwas_support(fe_meta)
re_validation <- add_gwas_support(re_meta)
asset1_validation <- add_gwas_support(asset1)
asset2_validation <- add_gwas_support(asset2)
csmgmm_validation <- add_gwas_support(csmgmm_t2)

plot_data <- bind_rows(
  fe_validation %>% mutate(Method = "FE"),
  re_validation %>% mutate(Method = "RE"),
  asset1_validation %>% mutate(Method = "ASSET1"),
  asset2_validation %>% mutate(Method = "ASSET2"),
  csmgmm_validation %>% mutate(Method = "csmGmm")
) %>%
  count(Method, GWAS_support) %>%
  complete(
    Method,
    GWAS_support = c("GWAS-supported", "Not GWAS-supported"),
    fill = list(n = 0)
  )

plot_data_percent <- plot_data %>%
  group_by(Method) %>%
  mutate(
    Percent = 100 * n / sum(n)
  ) %>%
  ungroup()

panel_B <- plot_data_percent %>%
  filter(GWAS_support == "GWAS-supported")

ggplot(panel_B, aes(x = Method, y = Percent)) +
  geom_col(width = 0.65) +
  geom_text(
    aes(label = sprintf("%.1f%%", Percent)),
    vjust = -0.5,
    size = 4
  ) +
  scale_y_continuous(
    expand = expansion(mult = c(0, 0.15))
  ) +
  labs(
    x = NULL,
    y = "GWAS-supported discoveries (%)"
  ) +
  theme_classic(base_size = 14)

ggsave(
  file.path(output_dir, "gwas_supported_discoveries.pdf"),
  width = 8,
  height = 6
)
